{
  "name": "template-react-vite",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready React + TypeScript + Vite + Ant Design template following the engineering handbook.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"{src,e2e}/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"{src,e2e}/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"{src,e2e}/**/*.{ts,tsx,json,css}\" \"*.{json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{src,e2e}/**/*.{ts,tsx,json,css}\" \"*.{json,md}\" \"docs/**/*.md\"",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run type-check && npm run test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "antd": "^6.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.13.6",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "{src,e2e}/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
